<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:alpha="1"
    android:background="#FFFFFF">

    <LinearLayout
        android:id="@+id/mainLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingBottom="30dp"
        android:paddingTop="30dp"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tierListTitle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:text="Really long tier list name to see how we deal with it"
                android:textAppearance="@style/TextAppearance.AppCompat.Large"
                android:textSize="25sp"
                android:textStyle="bold"
                android:textAlignment="viewStart"
                android:ellipsize="end"
                android:maxLines="1" />

            <ImageButton
                android:id="@+id/plusIcon"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:padding="5dp"
                android:background="@null"
                app:tint="#191919"
                android:scaleType="centerCrop"
                app:srcCompat="@drawable/plus" />

            <ImageButton
                android:id="@+id/tierSettings"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:padding="5dp"
                android:background="@null"
                app:tint="#191919"
                android:scaleType="centerCrop"
                app:srcCompat="@drawable/tiersettings" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tierContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:layout_weight="1"
            android:background="#2A2A2A"
            android:paddingLeft="4dp"
            android:paddingTop="8dp"
            android:paddingRight="4dp"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:id="@+id/unrankedContainer"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:background="#7A7A7A"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout
                android:id="@+id/unrankedContainerHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#7A7A7A"
                android:orientation="horizontal"
                android:padding="10dp">

                <TextView
                    android:id="@+id/tierTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Unranked"
                    android:textAlignment="viewStart"
                    android:textAppearance="@style/TextAppearance.AppCompat.Large"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/plusIconItem"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_gravity="center_vertical"
                    android:background="@null"
                    app:tint="#191919"
                    android:scaleType="centerCrop"
                    app:srcCompat="@drawable/plus" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/itemHolderUnranked"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#2A2A2A"
                android:padding="4dp"
                android:scrollbars="none"
                app:layout_constrainedHeight="true" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>