<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:alpha="1"
    android:background="#FFFFFF">

    <LinearLayout
        android:id="@+id/mainLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingBottom="30dp"
        android:paddingTop="30dp"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/tierListTitle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:text="Really long tier list name to see how we deal with it"
                android:textAppearance="@style/TextAppearance.AppCompat.Large"
                android:textSize="25sp"
                android:textStyle="bold"
                android:textAlignment="viewStart"
                android:ellipsize="end"
                android:maxLines="1"/>
            <ImageButton
                android:id="@+id/plusIcon"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:padding="5dp"
                android:background="@null"
                app:tint="#191919"
                android:scaleType="centerCrop"
                app:srcCompat="@drawable/plus"/>
            <ImageButton
                android:id="@+id/tierSettings"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:padding="5dp"
                android:background="@null"
                app:tint="#191919"
                android:scaleType="centerCrop"
                app:srcCompat="@drawable/tiersettings"/>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tierContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#2A2A2A"
            android:paddingLeft="4dp"
            android:paddingTop="8dp"
            android:paddingRight="4dp"
            android:paddingBottom="8dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
        />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/unplacedItems"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:background="#7A7A7A"
            android:columnWidth="90dp"
            android:numColumns="auto_fit"
            android:padding="4dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>